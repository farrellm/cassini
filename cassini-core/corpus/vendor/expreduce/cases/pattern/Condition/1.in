{3, 5, 2, 1} //. {x___, y_, z_, k___} /; (Order[y, z] == -1) -> {x, z, y, k}
Replace[1,a_Integer:>myfn[a]/;a>0]
Replace[-1,a_Integer:>myfn[a]/;a>0]
Replace[foo[2,3],foo[x_,y_]:>With[{a=x},x^2/;a==2]/;y==3]
Replace[foo[3,3],foo[x_,y_]:>With[{a=x},x^2/;a==2]/;y==3]
Replace[foo[2,4],foo[x_,y_]:>With[{a=x},x^2/;a==2]/;y==3]
Replace[bar[2],bar[x_]:>With[{a=x},x^2/;a==2]]
Replace[bar[3],bar[x_]:>With[{a=x},x^2/;a==2]]
Replace[foo[2,3],foo[x_,y_]:>Module[{a=x},x^2/;a==2]/;y==3]
Replace[foo[3,3],foo[x_,y_]:>Module[{a=x},x^2/;a==2]/;y==3]
Replace[foo[2,4],foo[x_,y_]:>Module[{a=x},x^2/;a==2]/;y==3]
Replace[bar[2],bar[x_]:>Module[{a=x},x^2/;a==2]]
Replace[bar[3],bar[x_]:>Module[{a=x},x^2/;a==2]]
Replace[2,x_:>Condition[Condition[Condition[x^2,x==2],x==2],x==2]]
Replace[3,x_:>Condition[Condition[Condition[x^2,x==2],x==2],x==2]]
