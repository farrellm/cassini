(* §4.7, D42: f::tag = "text" stores the text, past Protected; Message emits with the evaluated arguments; Off switches a message off for the session, and a switched-off message triggers no Check. *)
Set[MessageName[f, "bad"], "bad thing `1`"]
MessageName[f, "bad"]
MessageName[f, "other"]
Message[MessageName[f, "bad"], Plus[1, 1]]
Message[f, 1]
Set[MessageName[Sin, "foo"], "hi"]
Off[MessageName[Power, "infy"]]
Check[Power[0, -1], err]
On[MessageName[Power, "infy"]]
Power[0, -1]
Clear[f]
MessageName[f, "bad"]
ClearAll[f]
MessageName[f, "bad"]
