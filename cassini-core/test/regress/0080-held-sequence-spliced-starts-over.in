(* WL 15.0.1, $Version "15.0.1 for Linux x86 (64-bit) (July 2, 2026)", each input as an element of one unheld List. Step 5 splices a held literal Sequence, flattened through any Sequence inside it, and the evaluation starts over on the result with no rule tried; what an unheld argument evaluates to is spliced in the same round, and the argument it shifts out of a held position stays unevaluated. *)
SetAttributes[f1, HoldFirst]
SetAttributes[f2, HoldRest]
f2[Sequence[], Plus[1, 1]]
f2[Sequence[], Plus[1, 1], Plus[2, 2]]
f2[Sequence[Plus[1, 1]], Plus[2, 2]]
f2[Sequence[], Sequence[Plus[1, 1]]]
f2[Sequence[1, 2], Plus[3, 3]]
f1[Sequence[Plus[1, 1], Plus[2, 2]], Plus[3, 3]]
f1[Sequence[], Plus[1, 1]]
f1[Sequence[Plus[1, 1]]]
f1[Sequence[Sequence[], Plus[1, 1]]]
f1[Sequence[Unevaluated[Plus[1, 1]]]]
f1[Unevaluated[Sequence[Plus[1, 1], Plus[2, 2]]]]
SetDelayed[f1[Pattern[a, Blank[]], Pattern[b, Blank[]]], Hold[a, b]]
f1[Sequence[Plus[1, 1], Plus[2, 2]]]
SetDelayed[f2[Pattern[a, Blank[]]], Hold[a]]
f2[Sequence[], Plus[1, 1]]
f2[Sequence[], Sequence[Plus[1, 1]]]
