(* The pattern builtins and the sequence and commutative matchers (DESIGN.md §4.5, milestone 1b). *)
MatchQ[12345, Blank[Integer]]
MatchQ[f[a, b], f[Blank[], Blank[], BlankNullSequence[]]]
MatchQ[f[1, 2, a], f[BlankSequence[Integer]]]
Cases[List[1, a, 2, b, f[3]], Blank[Integer]]
Cases[List[1, a, 2, b, f[3]], Blank[Integer], Infinity]
Cases[List[f[1], g[2], f[3]], Rule[f[Pattern[x, Blank[]]], x]]
Replace[f[a, b, c], RuleDelayed[f[Pattern[x, Blank[]], Pattern[y, BlankSequence[]]], g[y, x]]]
Replace[List[f[1], f[2]], Rule[f[Pattern[x, Blank[]]], x], List[1]]
ReplaceAll[List[f[f[x]], f[x], g[f[x]]], Rule[f[Pattern[x, Blank[]]], x]]
ReplaceRepeated[List[f[f[x]], f[x], g[f[x]]], Rule[f[Pattern[x, Blank[]]], x]]
ReplaceAll[x, List[List[Rule[x, 1]], List[Rule[x, 2]]]]
ReplaceList[List[a, b, c, d], Rule[List[Pattern[x, BlankSequence[]], Pattern[y, BlankSequence[]]], List[List[x], List[y]]]]
ReplaceList[List[a, b, c, d], Rule[List[BlankNullSequence[], Pattern[x, BlankSequence[]], BlankNullSequence[]], List[x]], 4]
ReplaceList[Plus[a, b, c], RuleDelayed[Plus[Pattern[x, Blank[]], Pattern[y, Blank[]]], List[x, y]]]
SetAttributes[h, Orderless]
ReplaceList[h[a, b, c], RuleDelayed[h[Pattern[x, Blank[]], Pattern[y, Blank[]], Pattern[z, Blank[]]], List[x, y, z]]]
ReplaceList[h[a, b, c], RuleDelayed[h[Pattern[x, BlankSequence[]], Pattern[y, BlankSequence[]]], List[List[x], List[y]]]]
SetDelayed[k[h[g[Pattern[x, Blank[]]], Pattern[x, Blank[]], Pattern[y, Blank[]]]], List[x, y]]
k[h[2, g[1], g[2]]]
SetDelayed[s[Pattern[x, BlankSequence[]], Pattern[y, BlankNullSequence[]]], List[List[x], List[y]]]
s[a, b, c]
List[MatchQ[f[a, a, a], f[Repeated[a]]], MatchQ[f[], f[RepeatedNull[a]]], MatchQ[f[a, a, a], f[Repeated[a, List[2]]]]]
Replace[f[a], RuleDelayed[f[Pattern[x, Blank[]], Optional[Pattern[y, Blank[]], 0]], List[x, y]]]
ReplaceAll[List[x, Times[2, x], Times[-1, x]], RuleDelayed[Times[Optional[Pattern[n, Blank[]]], x], Power[y, n]]]
SetAttributes[fo, List[Flat, OneIdentity]]
ReplaceList[fo[a, b, c, d], RuleDelayed[fo[Pattern[u, Blank[]], Pattern[v, Blank[]]], List[u, v]]]
SetAttributes[fl, Flat]
SetDelayed[fl[a, b], x]
fl[a, b, c]
