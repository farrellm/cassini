(* Automatic simplification against Mathics3, which has WL's normal forms. *)
Plus[a, Plus[b, a]]
Times[x, x, y, Power[x, -1]]
Plus[Times[2, x], Times[3, x], y]
Power[Power[x, 2], 3]
Power[Times[x, y], 2]
Power[Times[2, x], 3]
Plus[Rational[1, 2], Rational[1, 3]]
Times[3, Power[2, Rational[1, 2]], Power[2, Rational[1, 2]]]
Power[0, -1]
Power[0, 0]
Subtract[a, a]
Divide[Times[a, b], b]
