(* Source: references/papers/wolfram-language/wolfram_ref_evaluation_of_expressions.html, "Tracing Evaluation" and "The Evaluation Stack"; the page shows inputs only, its outputs being images. *)
(* Trace[1 + 1], Trace[2^3 + 4], Trace[2^3 + 4^2 + 1], Trace[1 + 3^2] *)
Plus[1, 1]
Plus[Power[2, 3], 4]
Plus[Power[2, 3], Power[4, 2], 1]
Plus[1, Power[3, 2]]
